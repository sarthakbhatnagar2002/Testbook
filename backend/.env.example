DATABASE_URL="sqlite:///./dev.db"
# Must be 32+ characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=""
# Origin of the Vite dev server, for CORS
FRONTEND_ORIGIN="http://localhost:5173"
ENVIRONMENT="development"
# "lax" for local dev. Set to "none" in production if frontend and backend
# are on different origins (e.g. two separate Render services).
COOKIE_SAMESITE="lax"
# Where uploaded images are written. On Render this must point at a mounted
# persistent disk, or uploads vanish on every redeploy/restart.
UPLOAD_DIR="./uploads"
